# PipelineSleuth Environment Configuration

# Persistence
DATABASE_URL=sqlite+aiosqlite:///storage/pipelinesleuth.db

# Operator Authorization Credentials (Required for Patch Approval/Rejection)
# Generate a cryptographically random token (minimum 32 bytes recommended):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# OPERATOR_API_KEY=<GENERATE_A_SECURE_RANDOM_TOKEN_HERE>

# AI Model Provider ("ollama" or "openai")
AI_PROVIDER=ollama

# Ollama Local Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI-Compatible Remote API Configuration (optional)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Investigation Engine Boundaries
MAX_TOOL_CALLS=12
MAX_REPEATED_TOOL_CALLS=2
PER_TOOL_TIMEOUT_SECONDS=30
INVESTIGATION_TIMEOUT_SECONDS=300

# Docker Sandbox Settings
DOCKER_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_LIMIT=1g
ENABLE_DOCKER_SANDBOX=true

